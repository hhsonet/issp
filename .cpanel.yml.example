deployment:
  tasks:
    - export DEPLOY_PATH="/home/CPANEL_USER/issp-app"
    - export DOCROOT_PATH="/home/CPANEL_USER/public_html/issp"
    - /bin/mkdir -p "$DOCROOT_PATH"
    - /bin/rsync -a --delete --exclude='.git/' --exclude='.env' --exclude='node_modules/' --exclude='tests/' --exclude='writable/cache/' --exclude='writable/logs/' --exclude='writable/session/' --exclude='writable/uploads/' "$DEPLOY_PATH"/ "$DOCROOT_PATH"/
